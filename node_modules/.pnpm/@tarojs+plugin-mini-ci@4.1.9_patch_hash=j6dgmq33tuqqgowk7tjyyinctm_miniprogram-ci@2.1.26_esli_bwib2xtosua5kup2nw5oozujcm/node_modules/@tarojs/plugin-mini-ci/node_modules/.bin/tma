#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*) basedir=`cygpath -w "$basedir"`;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/workspace/projects/node_modules/.pnpm/tt-ide-cli@0.1.31_@types+node@24.12.4/node_modules/tt-ide-cli/bin/node_modules:/workspace/projects/node_modules/.pnpm/tt-ide-cli@0.1.31_@types+node@24.12.4/node_modules/tt-ide-cli/node_modules:/workspace/projects/node_modules/.pnpm/tt-ide-cli@0.1.31_@types+node@24.12.4/node_modules:/workspace/projects/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/workspace/projects/node_modules/.pnpm/tt-ide-cli@0.1.31_@types+node@24.12.4/node_modules/tt-ide-cli/bin/node_modules:/workspace/projects/node_modules/.pnpm/tt-ide-cli@0.1.31_@types+node@24.12.4/node_modules/tt-ide-cli/node_modules:/workspace/projects/node_modules/.pnpm/tt-ide-cli@0.1.31_@types+node@24.12.4/node_modules:/workspace/projects/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../../../../tt-ide-cli/bin/tma.js" "$@"
else
  exec node  "$basedir/../../../../tt-ide-cli/bin/tma.js" "$@"
fi

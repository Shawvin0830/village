esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/workspace/projects/node_modules/.pnpm/@tarojs+cli@4.1.9_@types+node@24.12.4/node_modules/@tarojs/cli/bin/node_modules:/workspace/projects/node_modules/.pnpm/@tarojs+cli@4.1.9_@types+node@24.12.4/node_modules/@tarojs/cli/node_modules:/workspace/projects/node_modules/.pnpm/@tarojs+cli@4.1.9_@types+node@24.12.4/node_modules/@tarojs/node_modules:/workspace/projects/node_modules/.pnpm/@tarojs+cli@4.1.9_@types+node@24.12.4/node_modules:/workspace/projects/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/workspace/projects/node_modules/.pnpm/@tarojs+cli@4.1.9_@types+node@24.12.4/node_modules/@tarojs/cli/bin/node_modules:/workspace/projects/node_modules/.pnpm/@tarojs+cli@4.1.9_@types+node@24.12.4/node_modules/@tarojs/cli/node_modules:/workspace/projects/node_modules/.pnpm/@tarojs+cli@4.1.9_@types+node@24.12.4/node_modules/@tarojs/node_modules:/workspace/projects/node_modules/.pnpm/@tarojs+cli@4.1.9_@types+node@24.12.4/node_modules:/workspace/projects/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../@tarojs/cli/bin/taro" "$@"
else
  exec node  "$basedir/../@tarojs/cli/bin/taro" "$@"
fi

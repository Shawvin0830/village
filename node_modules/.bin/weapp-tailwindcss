#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*) basedir=`cygpath -w "$basedir"`;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/workspace/projects/node_modules/.pnpm/weapp-tailwindcss@4.10.3_tailwindcss@4.1.18/node_modules/weapp-tailwindcss/bin/node_modules:/workspace/projects/node_modules/.pnpm/weapp-tailwindcss@4.10.3_tailwindcss@4.1.18/node_modules/weapp-tailwindcss/node_modules:/workspace/projects/node_modules/.pnpm/weapp-tailwindcss@4.10.3_tailwindcss@4.1.18/node_modules:/workspace/projects/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/workspace/projects/node_modules/.pnpm/weapp-tailwindcss@4.10.3_tailwindcss@4.1.18/node_modules/weapp-tailwindcss/bin/node_modules:/workspace/projects/node_modules/.pnpm/weapp-tailwindcss@4.10.3_tailwindcss@4.1.18/node_modules/weapp-tailwindcss/node_modules:/workspace/projects/node_modules/.pnpm/weapp-tailwindcss@4.10.3_tailwindcss@4.1.18/node_modules:/workspace/projects/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../weapp-tailwindcss/bin/weapp-tailwindcss.js" "$@"
else
  exec node  "$basedir/../weapp-tailwindcss/bin/weapp-tailwindcss.js" "$@"
fi
